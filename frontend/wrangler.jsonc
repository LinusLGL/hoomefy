{
  // Cloudflare Workers config. Cloudflare reads this on every deploy.
  // "name" must match the Worker's name in the Cloudflare dashboard (it is part of the site address).
  "name": "hoomefy",
  "compatibility_date": "2025-09-01",

  // Handles /api/furniture-search only; every other request is served straight from the built site.
  "main": "worker/index.ts",

  "assets": {
    // The output of `npm run build`. Never the project folder itself.
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths such as /studio or /gallery get index.html so the React router can handle them.
    "not_found_handling": "single-page-application",
    // Run the worker first for the API and for media (it adds Range support, see worker/index.ts).
    // Every other static file skips the worker, which keeps them free and unlimited.
    "run_worker_first": ["/api/*", "/video/*", "/audio/*"]
  },

  // Backup AI source (worker/redesign.ts): the same FLUX.2 klein model on Workers AI, free up to 10,000 neurons a day.
  "ai": { "binding": "AI" },

  // The site's Supabase project. Public (it is also in the built site); used only to check that a caller is signed in.
  // If you fork this project, replace it with your own project's URL.
  "vars": { "SUPABASE_URL": "https://gzidmlexfenyczrpydko.supabase.co" },

  // Per signed-in user, each minute: at most 4 designs on the backup source (REDESIGN_LIMITER, which also covers the item finder),
  // and at most 40 shop searches (SEARCH_LIMITER).
  "ratelimits": [
    { "name": "REDESIGN_LIMITER", "namespace_id": "1001", "simple": { "limit": 4, "period": 60 } },
    { "name": "SEARCH_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ]
}
