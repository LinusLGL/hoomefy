# Copy to .env.local for local work, or set these as BUILD variables in Cloudflare -> your Worker -> Settings -> Build -> Variables and secrets.
# Everything here is optional: with nothing set, the studio runs in demo mode on your own computer.

# --- AI image model ---------------------------------------------------------------------------------
# "live" calls FLUX.2 klein on Hugging Face (the default for production builds).
# "demo" uses a colour-grade stand-in and never leaves the device (the default for `npm run dev`).
# VITE_AI_PROVIDER=live
# Comma-separated Hugging Face Spaces to try in order. Default: black-forest-labs/FLUX.2-klein-4B
# VITE_AI_SPACES=black-forest-labs/FLUX.2-klein-4B

# --- Accounts and saved designs (Supabase) ----------------------------------------------------------
# Supabase dashboard -> Project Settings -> API. The anon key is public by design (row-level security
# protects the data), so it is safe to put here. Never put the service_role key in this file.
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# --- Access ------------------------------------------------------------------------------------------
# "true" lets visitors open the studio without an account (saving a design still needs one).
# VITE_ALLOW_GUESTS=false

# --- Look and feel -----------------------------------------------------------------------------------
VITE_ENABLE_HAUNTED=true

# Product search (server side only, set as a Secret in Cloudflare -> your Worker -> Settings -> Variables and secrets):
#   SERPER_API_KEY   optional key from serper.dev. Without it the studio shows shop links instead of live prices.
